<div class="mt-chips color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.topline != blank -%}<p class="mt-chips__topline">{{ section.settings.topline | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="mt-chips__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  </div>
  <div class="mt-marquee mt-marquee--chips" aria-label="Highlights">
    <div class="mt-marquee__track" style="--mt-marquee-speed: {{ section.settings.speed }}s;">
      {%- for half in (1..2) -%}
        <div class="mt-marquee__group" {% if half == 2 %}aria-hidden="true"{% endif %}>
          {%- for rep in (1..3) -%}
            {%- for block in section.blocks -%}
              <span class="mt-chip" {% if half == 1 and rep == 1 %}{{ block.shopify_attributes }}{% endif %}>{% render 'mt-icon', icon: block.settings.icon %}{{ block.settings.label | escape }}</span>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}
{% schema %}
{
  "name": "Scrolling chips",
  "settings": [
    { "type": "text", "id": "topline", "label": "Top line", "default": "FREE SHIPPING + 14-DAY MONEY-BACK + MIX ANY COLORS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why People Grab One" },
    { "type": "range", "id": "speed", "label": "Scroll speed (seconds per loop)", "min": 20, "max": 120, "step": 5, "default": 40 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [ { "type": "chip", "name": "Chip", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "heart", "label": "Heart" }, { "value": "return", "label": "Return arrow" }, { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "gift", "label": "Gift" }, { "value": "star", "label": "Star" }, { "value": "lock", "label": "Lock" }, { "value": "checkbox", "label": "Checkbox" }, { "value": "ruler", "label": "Ruler" }, { "value": "hood", "label": "Hood" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "moon", "label": "Moon" }, { "value": "check", "label": "Tick" } ], "default": "hood" },
    { "type": "text", "id": "label", "label": "Label", "default": "2-in-1 Hood" } ] } ],
  "max_blocks": 10,
  "presets": [ { "name": "Scrolling chips" } ]
}
{% endschema %}

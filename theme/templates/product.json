        "how": {
          "type": "mt_info_tab",
          "settings": {
            "icon": "gift",
            "heading": "How Does It Work?",
            "content": "<p>Plug in the camo projector, point it at any wall or ceiling and press start. Ducks, deer, boar and more run across the wall while you take aim with the pump-action shotgun. Hit the target and the game scores it, counts it, and sends the next one.</p>"
          }
        },
        "ship": {
          "type": "mt_info_tab",
          "settings": {
            "icon": "truck",
            "heading": "How Long Is Shipping?",
            "content": "<p>Orders are dispatched in 1 to 3 business days and delivery is 2 to 3 weeks from dispatch (please allow up to 30 days), with tracking emailed the moment it ships.</p>"
          }
        },
        "fit": {
          "type": "mt_info_tab",
          "settings": {
            "icon": "ruler",
            "heading": "Who Is It For?",
            "content": "<p>Ages 6 and up. The shotguns are toy blasters with infrared sensors, no projectiles, so it's safe to play indoors. Two guns come in every set so kids, parents and grandparents can play head to head.</p>"
          }
        },
        "box": {
          "type": "mt_info_tab",
          "settings": {
            "icon": "checkbox",
            "heading": "What's In The Box?",
            "content": "<p>One camo projector, two pump-action toy shotguns, power cable and quick-start guide. Batteries for the shotguns not included.</p>"
          }
        },
        "bundle": {

    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Does it work on any wall?",
            "icon": "question_mark",
            "row_content": "<p>Yes. It projects onto any flat, light-coloured surface: a wall, ceiling, garage door or a bedsheet. Dim the lights for the biggest, brightest picture.</p>"
          }
        },
        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How many people can play?",
            "icon": "question_mark",
            "row_content": "<p>Each set includes two shotguns, so two players can hunt at once. Grab the Family Pack or Ultimate Pack for four or six guns and run a tournament.</p>"
          }
        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is it safe for kids?",
            "icon": "question_mark",
            "row_content": "<p>The shotguns fire infrared light only. There are no pellets, darts or projectiles. Recommended for ages 6 and up with adult supervision for younger players.</p>"
          }
        },
        "q4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What if it turns up damaged?",
            "icon": "question_mark",
            "row_content": "<p>Email us a photo within 48 hours of delivery and we'll sort it out with a replacement or a refund. Add the 1 Year Warranty at checkout to be covered for a full 12 months against faults and defects.</p>"
          }
        }
      },

      "disabled": true
    },
    "wave": {
      "type": "mt-wave",
      "settings": {
        "animate": true,
        "flip": false,
        "speed": 14,
        "colour": "accent"
      }
    },
    "preorder": {
      "type": "mt-preorder",
      "settings": {
        "always_show": true,
        "color_scheme": "scheme-1",
        "heading": "PRE-ORDER NOTICE (please read)",
        "text": "<p>Please note the <strong>HunterRaid</strong> is currently in <strong>high demand</strong> and available for <strong>pre-order</strong>. Delivery takes approximately <strong>2-4 weeks</strong> from purchase. Every order is <strong>checked by hand</strong> before it ships to you.</p>"
      }
    }
  },
  "order": [
    "main",
    "faq",
    "reviews",
    "wave",
    "newsletter"
  ]

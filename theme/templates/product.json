{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "stars": {
          "type": "mt_stars",
          "settings": {
            "rating": "",
            "count": "",
            "label": "Reviews",
            "brackets": true,
            "badge": "",
            "align": "left",
            "italic": false
          },
          "disabled": true
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "payments": {
          "type": "mt_payments"
        },
        "review_slider": {
          "type": "mt_review_slider",
          "settings": {
            "text_1": "",
            "name_1": "",
            "text_2": "",
            "name_2": "",
            "text_3": "",
            "name_3": ""
          },
          "disabled": true
        },
        "ship": {
          "type": "mt_info_tab",
          "settings": {
            "icon": "truck",
            "heading": "Shipping & Delivery",
            "content": "<p>Every HunterRaid set is made to order, so it is produced after you buy. Delivery times vary with production and shipping, so we don't promise a fixed date. You'll get a tracking link by email as soon as your order ships.</p>"
          }
        },
        "box": {
          "type": "mt_info_tab",
          "settings": {
            "icon": "checkbox",
            "heading": "What's in the Box",
            "content": "<p>1 HunterRaid projector, 2 shotgun-style controllers and everything you need to start playing. Buy 2 or more and you get that many full sets.</p>"
          }
        },
        "bundle": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'clausegrab-bundle' %}"
          }
        },
        "features": {
          "type": "mt_bullets",
          "settings": {
            "align": "left",
            "layout": "grid",
            "text_1": "3 Hunting Modes",
            "emoji_1": "🦌",
            "icon_1": "none",
            "preset_1": "",
            "text_2": "2 Controllers Included",
            "emoji_2": "🎯",
            "icon_2": "none",
            "preset_2": "",
            "text_3": "Wall Projection",
            "emoji_3": "📽️",
            "icon_3": "none",
            "preset_3": "",
            "text_4": "Live Score Tracking",
            "emoji_4": "🏆",
            "icon_4": "none",
            "preset_4": ""
          }
        },
        "warranty": {
          "type": "mt_info_tab",
          "settings": {
            "icon": "shield",
            "heading": "1-Year Warranty",
            "content": "<p>Add the 1-Year Warranty at checkout and if your projector or controllers stop working within a year, we'll repair or replace them. Contact us through the <a href=\"/pages/contact\">Contact</a> page with your order number.</p>"
          }
        },
        "trust": {
          "type": "mt_trust",
          "settings": {
            "style": "big",
            "icon_1": "heart",
            "label_1": "Satisfaction Guarantee",
            "icon_2": "return",
            "label_2": "Free Returns",
            "icon_3": "truck",
            "label_3": "Free Shipping",
            "icon_4": "shield",
            "label_4": ""
          }
        }
      },
      "block_order": [
        "title",
        "stars",
        "price",
        "features",
        "variant_picker",
        "bundle",
        "buy_buttons",
        "payments",
        "box",
        "ship",
        "warranty",
        "trust",
        "review_slider"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "newsletter": {
      "type": "newsletter",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Subscribe to our emails",
            "heading_size": "h2"
          }
        },
        "paragraph": {
          "type": "paragraph",
          "settings": {
            "text": "<p>Be first to hear about new hunting modes and deals.</p>"
          }
        },
        "email_form": {
          "type": "email_form"
        }
      },
      "block_order": [
        "heading",
        "paragraph",
        "email_form"
      ],
      "settings": {
        "color_scheme": "scheme-4",
        "full_width": true,
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How does HunterRaid work?",
            "icon": "question_mark",
            "row_content": "<p>Point the projector at a wall, pick a game mode and the hunt appears on your wall. Aim the controllers at the targets and pull the trigger to score points.</p>"
          }
        },
        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What game modes are there?",
            "icon": "question_mark",
            "row_content": "<p>Three hunting modes: Buck Challenge, Turkey Woods and Duck Marsh. Each one tracks your score live on the wall.</p>"
          }
        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How many people can play?",
            "icon": "question_mark",
            "row_content": "<p>Two controllers come in every set, so two players can go head to head. Grab a second set for even bigger game nights.</p>"
          }
        },
        "q4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Who is it for?",
            "icon": "question_mark",
            "row_content": "<p>Kids, teens and adults. It's built for family game nights, parties and anyone who loves hunting games.</p>"
          }
        },
        "q5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does shipping take?",
            "icon": "question_mark",
            "row_content": "<p>Every HunterRaid set is made to order, so it is produced after you buy. Delivery times vary with production and shipping, so we don't promise a fixed date. Once your order ships, you'll receive a tracking link by email. 🦌</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ],
      "settings": {
        "caption": "",
        "heading": "Your Questions, Answered 🦌",
        "heading_size": "h1",
        "heading_alignment": "center",
        "layout": "none",
        "color_scheme": "scheme-1",
        "container_color_scheme": "scheme-1",
        "open_first_collapsible_row": false,
        "image_ratio": "adapt",
        "desktop_layout": "image_second",
        "padding_top": 40,
        "padding_bottom": 48
      }
    },
    "band": {
      "type": "mt-ticker",
      "blocks": {},
      "block_order": [],
      "settings": {
        "colour": "accent",
        "aria_label": "Store promises",
        "speed": 45,
        "heading": "",
        "review_speed": 70,
        "show_waves": true,
        "animate": true,
        "wave_speed": 14
      }
    },
    "reviews": {
      "type": "mt-reviews",
      "blocks": {
        "r1": {
          "type": "review",
          "settings": {
            "title": "",
            "text": "",
            "name": "",
            "location": "",
            "verified": true,
            "image": ""
          }
        },
        "r2": {
          "type": "review",
          "settings": {
            "title": "",
            "text": "",
            "name": "",
            "location": "",
            "verified": true,

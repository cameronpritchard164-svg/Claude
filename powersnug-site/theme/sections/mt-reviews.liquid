<div class="mt-reviews color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="mt-reviews__heading h1">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="mt-reviews__grid list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="mt-review" {{ block.shopify_attributes }}>
          <div class="mt-review__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '375, 550, 750, 900', sizes: '(min-width: 750px) 33vw, 80vw', alt: block.settings.image.alt }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <span class="mt-review__quote" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M10.5 6.5H5.2v6h2.7c0 1.9-1 3-2.9 3.4v2.1c3.5-.4 5.5-2.7 5.5-6.3zm8.5 0h-5.3v6h2.7c0 1.9-1 3-2.9 3.4v2.1c3.5-.4 5.5-2.7 5.5-6.3z"/></svg>
            </span>
          </div>
          <div class="mt-review__body">
            <div class="mt-review__stars" aria-label="5 out of 5 stars">★★★★★</div>
            {%- if block.settings.title != blank -%}<h3 class="mt-review__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
            <p class="mt-review__text">{{ block.settings.text | escape }}</p>
            <div class="mt-review__foot">
              <div class="mt-review__who">
                {%- if block.settings.avatar != blank -%}
                  {{ block.settings.avatar | image_url: width: 100 | image_tag: width: 36, height: 36, loading: 'lazy', alt: '', class: 'mt-review__avatar' }}
                {%- elsif block.settings.avatar_url != blank -%}
                  <img src="{{ block.settings.avatar_url | escape }}" width="36" height="36" loading="lazy" alt="" class="mt-review__avatar">
                {%- endif -%}
                <div>
                  {%- if block.settings.name != blank -%}<p class="mt-review__name">{{ block.settings.name | escape }}</p>{%- endif -%}
                  {%- if block.settings.location != blank -%}<p class="mt-review__loc">{{ block.settings.location | escape }}</p>{%- endif -%}
                </div>
              </div>
              {%- if block.settings.verified -%}
                <span class="mt-review__verified"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 6.3 4.8 8.6 9.5 3.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Verified</span>
              {%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}

{% schema %}
{
  "name": "Customer review cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Customers Are Saying"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Review title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review",
          "default": "Add your customer review here."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Customer name"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Customer avatar (small circle)"
        },
        {
          "type": "text",
          "id": "avatar_url",
          "label": "Avatar image link (optional)"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "City, State"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show Verified badge",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Customer review cards",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%} Line icons for master theme. Accepts: icon {%- endcomment -%}
{%- capture a -%}class="mt-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"{%- endcapture -%}
{%- case icon -%}
  {%- when 'heart' -%}
    <svg {{ a }}><path d="M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.7c0 5.6-7.5 10.2-7.5 10.2z"/></svg>
  {%- when 'return' -%}
    <svg {{ a }}><path d="M8 5 4 9l4 4"/><path d="M4 9h11a5 5 0 0 1 0 10H9"/></svg>
  {%- when 'truck' -%}
    <svg {{ a }}><path d="M2.5 6.5h11v10h-11z"/><path d="M13.5 10h4l3.5 3.5v3h-7.5"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
  {%- when 'shield' -%}
    <svg {{ a }}><path d="M12 3 5 5.8v5.4c0 4.4 2.9 8.2 7 9.8 4.1-1.6 7-5.4 7-9.8V5.8z"/><path d="m9 12 2.2 2.2L15.2 10"/></svg>
  {%- when 'gift' -%}
    <svg {{ a }}><path d="M4 11h16v9.5H4z"/><path d="M3 7.5h18V11H3z"/><path d="M12 7.5v13"/><path d="M12 7.5S10.5 3.5 8.2 3.5a2 2 0 0 0 0 4zM12 7.5s1.5-4 3.8-4a2 2 0 0 1 0 4z"/></svg>
  {%- when 'star' -%}
    <svg {{ a }}><path d="m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.8z"/></svg>
  {%- when 'lock' -%}
    <svg {{ a }}><rect x="5" y="10.5" width="14" height="10" rx="1.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
  {%- when 'ruler' -%}
    <svg {{ a }}><rect x="2.5" y="8.5" width="19" height="7" rx="1.5"/><path d="M6.5 8.5v3M10.5 8.5v4M14.5 8.5v3M18.5 8.5v4"/></svg>
  {%- when 'hood' -%}
    <svg {{ a }}><path d="M12 3c-4.5 0-7 3.5-7 8v9h14v-9c0-4.5-2.5-8-7-8z"/><path d="M12 20V10"/><circle cx="12" cy="7.5" r="1.8"/></svg>
  {%- when 'sparkle' -%}
    <svg {{ a }}><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M18.5 16.5l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/></svg>
  {%- when 'moon' -%}
    <svg {{ a }}><path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z"/></svg>
  {%- when 'cross' -%}
    <svg {{ a }}><path d="M6 6l12 12M18 6 6 18"/></svg>
  {%- when 'check' -%}
    <svg {{ a }}><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
  {%- when 'tiktok' -%}
    <svg {{ a }}><path d="M14 4v9.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 4c.5 2.5 2 4 4.5 4.3"/></svg>
  {%- when 'instagram' -%}
    <svg {{ a }}><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17" cy="7" r=".9" fill="currentColor"/></svg>
  {%- when 'facebook' -%}
    <svg {{ a }}><path d="M14 20v-7h2.5l.5-3H14V8.2c0-.9.3-1.5 1.6-1.5H17V4.1c-.3 0-1.3-.1-2.4-.1-2.4 0-3.9 1.4-3.9 4V10H8v3h2.7v7"/></svg>
  {%- else -%}
    <svg {{ a }}><rect x="4" y="4" width="16" height="16" rx="2"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>
{%- endcase -%}

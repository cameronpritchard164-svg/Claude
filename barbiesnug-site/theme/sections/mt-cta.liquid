<div class="mt-cta color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width mt-cta__inner">
    {%- if section.settings.show_shield -%}
      <span class="mt-cta__shield">{% render 'mt-icon', icon: 'shield' %}</span>
    {%- endif -%}
    {% render 'mt-heading', accent: section.settings.heading_accent, heading: section.settings.heading, sub: section.settings.sub, accent_end: section.settings.accent_end %}
    {%- if section.settings.text != blank -%}<div class="mt-cta__text rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="mt-cta__list">
        {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="button mt-cta__button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
    {%- if section.settings.check_1 != blank or section.settings.check_2 != blank or section.settings.check_3 != blank -%}
      <ul class="mt-cta__checks">
        {%- for i in (1..3) -%}{%- assign k = 'check_' | append: i -%}
          {%- if section.settings[k] != blank -%}<li>{% render 'mt-icon', icon: 'check' %}{{ section.settings[k] | escape }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>
{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}
{% schema %}
{
  "name": "Heading + text + button",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_shield",
      "label": "Show shield icon above",
      "default": false
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading (accent colour part)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (rest)",
      "default": "Two Looks. One Hoodie."
    },
    {
      "type": "checkbox",
      "id": "accent_end",
      "label": "Accent part goes after the heading",
      "default": false
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "check_1",
      "label": "Tick line 1"
    },
    {
      "type": "text",
      "id": "check_2",
      "label": "Tick line 2"
    },
    {
      "type": "text",
      "id": "check_3",
      "label": "Tick line 3"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Zip it up on cold walks"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heading + text + button"
    }
  ]
}
{% endschema %}

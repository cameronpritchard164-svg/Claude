{%- comment -%} Centred heading with an accent-coloured part. Accepts: accent, heading, sub, accent_end {%- endcomment -%}
{%- if accent != blank or heading != blank -%}
  <h2 class="mt-h">
    {%- if accent_end -%}{{ heading | escape }}{% if accent != blank %}<span class="mt-h__accent">{{ accent | escape }}</span>{% endif %}
    {%- else -%}{% if accent != blank %}<span class="mt-h__accent">{{ accent | escape }}</span>{% endif %}{{ heading | escape }}{%- endif -%}
  </h2>
{%- endif -%}
{%- if sub != blank -%}<p class="mt-h__sub">{{ sub | escape }}</p>{%- endif -%}

<div class="mt-cards section-{{ section.id }}-padding">
  <div class="page-width">
    {% render 'mt-heading', accent: section.settings.heading_accent, heading: section.settings.heading, sub: section.settings.sub, accent_end: section.settings.accent_end %}
    <ul class="mt-cards__grid list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="mt-cards__card" {{ block.shopify_attributes }}>
          <span class="mt-cards__icon">{% render 'mt-icon', icon: block.settings.icon %}</span>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}
{% schema %}
{
  "name": "Icon cards",
  "settings": [
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading (accent part)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (rest)",
      "default": "Made For Anyone Who Is Done With.."
    },
    {
      "type": "checkbox",
      "id": "accent_end",
      "label": "Accent part goes after the heading",
      "default": false
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "return",
              "label": "Return arrow"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "lock",
              "label": "Lock"
            },
            {
              "value": "checkbox",
              "label": "Checkbox"
            },
            {
              "value": "ruler",
              "label": "Ruler"
            },
            {
              "value": "hood",
              "label": "Hood"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "moon",
              "label": "Moon"
            },
            {
              "value": "check",
              "label": "Tick"
            }
          ],
          "default": "sparkle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Icon cards",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}

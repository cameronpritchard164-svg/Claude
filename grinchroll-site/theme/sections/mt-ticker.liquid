{%- comment -%} Coloured band: scrolling messages, a heading, and a scrolling review row. Wave edge above and below. {%- endcomment -%}
<div class="mt-band mt-band--{{ section.settings.colour }}">
  {%- if section.settings.show_waves -%}
    {% render 'mt-wave-svg', animate: section.settings.animate, flip: false, speed: section.settings.wave_speed, colour: section.settings.colour %}
  {%- endif -%}

  <div class="mt-band__strip">
    {%- assign messages = section.blocks | where: 'type', 'message' -%}
    {%- assign reviews = section.blocks | where: 'type', 'review' -%}

    {%- if messages.size > 0 -%}
      <div class="mt-marquee mt-marquee--band" aria-label="{{ section.settings.aria_label | escape }}">
        <div class="mt-marquee__track" style="--mt-marquee-speed: {{ section.settings.speed }}s;">
          {%- for half in (1..2) -%}
            <div class="mt-marquee__group" {% if half == 2 %}aria-hidden="true"{% endif %}>
              {%- for rep in (1..4) -%}
                {%- for block in messages -%}
                  <span class="mt-marquee__item" {% if half == 1 and rep == 1 %}{{ block.shopify_attributes }}{% endif %}>
                    {{- block.settings.text | escape -}}
                  </span>
                {%- endfor -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <p class="mt-band__heading">{{ section.settings.heading | escape }}</p>
    {%- endif -%}

    {%- if reviews.size > 0 -%}
      <div class="mt-marquee mt-marquee--reviews" aria-label="Customer reviews">
        <div class="mt-marquee__track" style="--mt-marquee-speed: {{ section.settings.review_speed }}s;">
          {%- for half in (1..2) -%}
            <div class="mt-marquee__group" {% if half == 2 %}aria-hidden="true"{% endif %}>
              {%- for rep in (1..2) -%}
                {%- for block in reviews -%}
                  <figure class="mt-bandrev" {% if half == 1 and rep == 1 %}{{ block.shopify_attributes }}{% endif %}>
                    <blockquote class="mt-bandrev__text">&ldquo;{{ block.settings.text | escape }}&rdquo;</blockquote>
                    <figcaption class="mt-bandrev__foot">
                      {%- if block.settings.verified -%}
                        <span class="mt-bandrev__tick" aria-hidden="true"><svg viewBox="0 0 12 12"><circle cx="6" cy="6" r="6" fill="currentColor"/><path d="M3.2 6.2 5 8 8.8 4.2" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                      {%- endif -%}
                      <span class="mt-bandrev__name">{{ block.settings.name | escape }}</span>
                      <span class="mt-bandrev__stars" aria-label="5 out of 5 stars">★★★★★</span>
                    </figcaption>
                  </figure>
                {%- endfor -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_waves -%}
    {% render 'mt-wave-svg', animate: section.settings.animate, flip: true, speed: section.settings.wave_speed, colour: section.settings.colour %}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Ticker band",
  "settings": [
    { "type": "paragraph", "content": "Scrolling messages on a coloured band with a wave edge top and bottom. Add Review blocks to scroll reviews underneath the heading." },
    { "type": "select", "id": "colour", "label": "Colour", "options": [ { "value": "accent", "label": "Accent colour" }, { "value": "secondary", "label": "Secondary colour" } ], "default": "accent" },
    { "type": "text", "id": "aria_label", "label": "Screen reader label", "default": "Store promises" },
    { "type": "range", "id": "speed", "label": "Message scroll speed (seconds per loop)", "min": 20, "max": 120, "step": 5, "default": 45 },
    { "type": "header", "content": "Heading and reviews" },
    { "type": "text", "id": "heading", "label": "Heading under the messages" },
    { "type": "range", "id": "review_speed", "label": "Review scroll speed (seconds per loop)", "min": 20, "max": 160, "step": 5, "default": 70 },
    { "type": "header", "content": "Wave edges" },
    { "type": "checkbox", "id": "show_waves", "label": "Show wave edges", "default": true },
    { "type": "checkbox", "id": "animate", "label": "Animate the waves", "default": true },
    { "type": "range", "id": "wave_speed", "label": "Wave speed (seconds per loop)", "min": 6, "max": 30, "step": 1, "unit": "s", "default": 14 }
  ],
  "blocks": [
    { "type": "message", "name": "Message", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "FREE SHIPPING!" } ] },
    { "type": "review", "name": "Review", "settings": [
      { "type": "textarea", "id": "text", "label": "Review", "default": "Add a short customer review here." },
      { "type": "text", "id": "name", "label": "Name", "default": "First name, initial" },
      { "type": "checkbox", "id": "verified", "label": "Show verified tick", "default": true } ] }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "Ticker band", "blocks": [ { "type": "message" }, { "type": "message" }, { "type": "message" } ] } ]
}
{% endschema %}
